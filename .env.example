APP_ENV=production
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# sqlite for one local worker; postgres is recommended for multiple workers
DATABASE_DIALECT=sqlite
SQLITE_PATH=/data/konspekai.sqlite
DATABASE_URL=
POSTGRES_USER=konspekai
POSTGRES_PASSWORD=
POSTGRES_DB=konspekai

# Use host Ollama in the default compose setup. On Linux, bind the host Ollama
# service only to the Docker bridge gateway (not 0.0.0.0), or use a restricted
# local TCP forward. The optional ollama profile avoids host networking.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:14b
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
API_ACCESS_TOKEN=
TRUST_PROXY=false
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
LLM_NORMALIZATION_MODEL=
LLM_SUMMARY_MODEL=
LLM_TIMEOUT_MS=180000
LLM_MAX_INPUT_CHARS=24000
LLM_MAX_OUTPUT_TOKENS=4096
LLM_MAX_RETRIES=1
PROMPTS_DIRECTORY=packages/llm/prompts

# Map each selectable language to an installed Vosk model directory.
VOSK_MODELS_JSON={"ru":"/models/ru"}
VOSK_MODEL_URL=https://alphacephei.com/vosk/models/vosk-model-small-ru-0.22.zip
ASR_SAMPLE_RATE=16000
FFMPEG_PATH=ffmpeg
FFMPEG_THREADS=2
MEDIA_PROCESS_TIMEOUT_MS=3600000
MEDIA_PROBE_TIMEOUT_MS=30000

MAX_UPLOAD_BYTES=536870912
MAX_TEXT_CHARS=1000000
MAX_MEDIA_DURATION_SECONDS=14400
WORKER_CONCURRENCY=1
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_MS=5000
JOB_LEASE_SECONDS=900
JOB_RETENTION_DAYS=7
UPLOAD_ORPHAN_RETENTION_HOURS=24
UPLOAD_DIRECTORY=/data/uploads
DATABASE_BUSY_TIMEOUT_MS=10000
